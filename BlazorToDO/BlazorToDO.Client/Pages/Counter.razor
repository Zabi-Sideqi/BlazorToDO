@page "/counter"

<PageTitle>Counter</PageTitle>

<h1>Counter</h1>

<p role="status">Current count: @currentCount</p>

<button class="btn btn-secondary" @onclick="DecrementCount">Pecheq me</button>

@code {
    private int currentCount = 20;

    private void DecrementCount()
    {
        currentCount--;
    }
}
