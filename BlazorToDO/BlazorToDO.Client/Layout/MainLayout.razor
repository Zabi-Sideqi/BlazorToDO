@inherits LayoutComponentBase

<div class="min-vh-100 d-flex flex-column bg-body-tertiary">
<header class="sticky-top">
    <NavBar NavTitle="ToDo">
        <button class="btn btn-default btn-sm" type="button">Inserted with fragment</button>
    </NavBar>
</header>
<main class="flex-grow-1">
<div class="container py-4">
@Body
</div>
</main>
</div>

<footer class="border-top bg-body">
<div class="container py-3 small text-secondary">
ToDo List Blazor
</div>
</footer>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
